# Protect secrets and private data if the repository root is ever used as the
# Apache DocumentRoot (cPanel/Passenger deployments often are).
Options -Indexes

# Never serve dotfiles (.env, .git, .htaccess itself, ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Sensitive runtime data
<FilesMatch "\.(env|db|db-shm|db-wal|log|session|lock|ini|sqlite|sqlite3|pem|key|crt)$">
    Require all denied
</FilesMatch>

# Never serve Python sources / caches directly
<FilesMatch "\.(py|pyc|pyo)$">
    Require all denied
</FilesMatch>
